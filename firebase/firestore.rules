rules_version = '2';

// =====================================================================
// Aswer Top Up — règ sekirite Firestore
//
// Kijan pou itilize l: Firebase console → Firestore Database → Rules →
// kole tout fichye sa a → Publish.
//
// Plan gratis la (Spark) pa gen sèvè pou nou, kidonk se règ sa yo ki
// pwoteje kòb la. Solde yon kliyan ka chanje sèlman nan menm operasyon
// ak youn nan aksyon sa yo, epi montan an dwe egzak:
//   - yon nouvo kòmand (solde - pri pake a nan tab packages la)
//   - yon nouvo transfè (solde moun k ap voye a - montan, moun k ap
//     resevwa a + montan)
//   - yon admin ki konfime yon depo (+ montan depo a) oswa ki refize
//     yon kòmand (+ pri kòmand lan, yon sèl fwa)
// Yon kòmand "unpaid" (kliyan an peye dirèkteman ak MonCash/NatCash) pa
// touche solde a: admin nan konfime peman an, oswa li refize l san ranbousman.
//
// Admin yo: pwopriyetè a se admin ou te mete alamen nan konsòl la
// (is_admin = true, san admin_by). Se sèlman li ki ka ajoute oswa retire
// lòt admin nan Panneau admin lan, epi chwazi wòl yo: "full" (tout bagay)
// oswa "orders" (trete kòmand sèlman: pa depo, pa pwodwi, pa paramèt).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Zouti ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userDoc(id) { return /databases/$(database)/documents/users/$(id); }
    function orderDoc(id) { return /databases/$(database)/documents/orders/$(id); }
    function transferDoc(id) { return /databases/$(database)/documents/transfers/$(id); }
    function depositDoc(id) { return /databases/$(database)/documents/deposits/$(id); }
    function packageDoc(id) { return /databases/$(database)/documents/packages/$(id); }
    function exchangeDoc(id) { return /databases/$(database)/documents/exchange/$(id); }
    function walletCodeDoc(id) { return /databases/$(database)/documents/walletCodes/$(id); }
    function depositRefDoc(id) { return /databases/$(database)/documents/depositRefs/$(id); }
    function isAdmin() { return signedIn() && get(userDoc(me())).data.is_admin == true; }
    // Admin konplè: tout admin, eksepte sa pwopriyetè a bay wòl "kòmand sèlman" (admin_role 'orders')
    function isFullAdmin() {
      let u = get(userDoc(me())).data;
      return signedIn() && u.is_admin == true && u.get('admin_role', 'full') != 'orders';
    }
    function isOwner() {
      let u = get(userDoc(me())).data;
      return signedIn() && u.is_admin == true && u.get('admin_by', null) == null;
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function exactKeys(keys) { return request.resource.data.keys().hasOnly(keys) && request.resource.data.keys().hasAll(keys); }
    function optString(v, max) { return v == null || (v is string && v.size() <= max); }
    // Foto pwofil: yon ti imaj (data:) sit la redimansyone, oswa foto kont Google la (https)
    function validPhoto(p) {
      return p == null || (p is string && p.size() <= 60000
        && (p.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$') || p.matches('^https://[^ "<>]+$')));
    }

    // ---------- Kliyan yo ----------
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if signedIn() && me() == uid && validNewUser(uid);
      allow update: if signedIn() && (
        (me() == uid && changedOnly(['full_name', 'photo'])
          && optString(request.resource.data.full_name, 60)
          && validPhoto(request.resource.data.get('photo', null)))
        || (me() == uid && spendOk(uid))
        || transferCreditOk(uid)
        || adminCreditOk(uid)
        || adminRoleOk(uid)
      );

      // Notifikasyon kliyan an (admin yo ka ekri l tou)
      match /notifications/{nid} {
        allow read: if signedIn() && me() == uid;
        allow update: if signedIn() && me() == uid
          && changedOnly(['read_at']) && request.resource.data.read_at == request.time;
        allow create: if signedIn() && validNotification()
          && (me() == uid || isAdmin() || transferNotificationOk(uid));
      }
    }

    function validNewUser(uid) {
      let d = request.resource.data;
      return exactKeys(['email', 'full_name', 'wallet_code', 'balance', 'total_spent', 'is_admin',
                        'created_at', 'last_op', 'last_credit', 'last_admin_op'])
        && d.email == request.auth.token.email
        && optString(d.full_name, 60)
        && d.wallet_code is string && d.wallet_code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && d.balance == 0 && d.total_spent == 0 && d.is_admin == false
        && d.created_at == request.time
        && d.last_op == null && d.last_credit == null && d.last_admin_op == null
        && getAfter(walletCodeDoc(d.wallet_code)).data.uid == uid;
    }

    // Kliyan an peye pou yon kòmand oswa li voye kòb
    function spendOk(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let op = after.last_op;
      return changedOnly(['balance', 'total_spent', 'last_op'])
        && after.balance is int && after.balance >= 0
        && op.keys().hasOnly(['kind', 'id'])
        && ((op.kind == 'order' && orderSpendOk(uid, op.id, before, after))
            || (op.kind == 'transfer' && transferSpendOk(uid, op.id, before, after)));
    }

    function orderSpendOk(uid, id, before, after) {
      let order = getAfter(orderDoc(id)).data;
      return !exists(orderDoc(id))
        && order.user_id == uid
        && after.balance == before.balance - order.price
        && after.total_spent == before.total_spent + order.price;
    }

    function transferSpendOk(uid, id, before, after) {
      let t = getAfter(transferDoc(id)).data;
      return !exists(transferDoc(id))
        && t.from_user == uid
        && after.balance == before.balance - t.amount
        && after.total_spent == before.total_spent;
    }

    // Moun k ap voye kòb la ajoute montan an sou solde moun k ap resevwa a
    function transferCreditOk(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let id = after.last_credit;
      let t = getAfter(transferDoc(id)).data;
      return signedIn() && me() != uid
        && changedOnly(['balance', 'last_credit'])
        && id is string
        && !exists(transferDoc(id))
        && t.to_user == uid && t.from_user == me()
        && after.balance == before.balance + t.amount;
    }

    // Admin nan konfime yon depo oswa li ranbouse yon kòmand refize
    function adminCreditOk(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let op = after.last_admin_op;
      return isAdmin()
        && changedOnly(['balance', 'total_spent', 'last_admin_op'])
        && op.keys().hasOnly(['kind', 'id'])
        && ((op.kind == 'deposit' && isFullAdmin() && depositCreditOk(uid, op.id, before, after))
            || (op.kind == 'refund' && refundOk(uid, op.id, before, after))
            || (op.kind == 'paid' && isFullAdmin() && paidOk(uid, op.id, before, after))
            || (op.kind == 'referral' && isFullAdmin() && referralCreditOk(uid, op.id, before, after)));
    }

    // Bonis parennaj: zanmi an (id) ak moun ki envite l la jwenn bonis paramèt la, yon sèl fwa
    function referralCreditOk(uid, id, before, after) {
      let path = /databases/$(database)/documents/referrals/$(id);
      let r = get(path).data;
      let bonus = get(/databases/$(database)/documents/settings/referral).data.bonus;
      return r.rewarded == false && getAfter(path).data.rewarded == true
        && (uid == id || uid == r.referrer_uid)
        && bonus is int && bonus > 0
        && after.balance == before.balance + bonus
        && after.total_spent == before.total_spent;
    }

    function depositCreditOk(uid, id, before, after) {
      let path = depositDoc(id);
      let d = get(path).data;
      return d.user_id == uid && d.status == 'pending' && getAfter(path).data.status == 'completed'
        && after.balance == before.balance + d.amount
        && after.total_spent == before.total_spent;
    }

    function refundOk(uid, id, before, after) {
      let path = orderDoc(id);
      let o = get(path).data;
      return o.user_id == uid && !(o.status in ['refused', 'unpaid']) && getAfter(path).data.status == 'refused'
        && after.balance == before.balance + o.price
        && after.total_spent == before.total_spent - o.price;
    }

    // Admin nan resevwa peman dirèk yon kòmand: li konte nan total kliyan an, solde a pa chanje
    function paidOk(uid, id, before, after) {
      let path = orderDoc(id);
      let o = get(path).data;
      return o.user_id == uid && o.status == 'unpaid'
        && getAfter(path).data.status in ['pending', 'processing', 'delivered']
        && after.balance == before.balance
        && after.total_spent == before.total_spent + o.price;
    }

    // Pwopriyetè a fè yon lòt kliyan admin (admin_by = li menm, wòl "full" oswa "orders"),
    // li chanje wòl li, oswa li retire l
    function adminRoleOk(uid) {
      let after = request.resource.data;
      return me() != uid && isOwner()
        && changedOnly(['is_admin', 'admin_by', 'admin_role'])
        && ((after.is_admin == true && after.admin_by == me() && after.get('admin_role', 'full') in ['full', 'orders'])
            || (after.is_admin == false && after.admin_by == null && after.get('admin_role', null) == null));
    }

    // ---------- ASWER-ID (pou transfè yo) ----------
    match /walletCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == me()
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && !exists(userDoc(me()))
        && getAfter(userDoc(me())).data.wallet_code == code;
    }

    // ---------- Pri yo ----------
    // Pake ki gen product_id yo se admin nan ki ajoute yo sou yon pwodwi
    // (group = tit seksyon an sou paj pwodwi a)
    match /packages/{id} {
      allow read: if true;
      allow create, update: if isFullAdmin() && validPackage();
      allow delete: if isFullAdmin();
    }

    function validPackage() {
      let d = request.resource.data;
      return d.keys().hasAll(['product_name', 'label', 'price', 'needs_id', 'available', 'sort'])
        && d.keys().hasOnly(['product_name', 'label', 'price', 'needs_id', 'available', 'sort', 'product_id', 'group'])
        && d.product_name is string && d.product_name.size() <= 80
        && d.label is string && d.label.size() >= 1 && d.label.size() <= 60
        && d.price is int && d.price > 0 && d.price <= 1000000
        && d.needs_id is bool && d.available is bool && d.sort is int
        && (!('product_id' in d) || (d.product_id is string && d.product_id.size() <= 60))
        && (!('group' in d) || (d.group is string && d.group.size() <= 40));
    }

    // ---------- Pwodwi admin nan ajoute ----------
    match /products/{id} {
      allow read: if true;
      allow create, update: if isFullAdmin() && validProduct();
      allow delete: if isFullAdmin();
    }

    function validProduct() {
      let d = request.resource.data;
      return exactKeys(['name', 'category', 'image', 'is_new', 'player_id', 'sort', 'created_at'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.category in ['Jwèt', 'Abònman', 'Gift Card', 'Finans']
        && optString(d.image, 350000)
        && d.is_new is bool && d.player_id is bool && d.sort is int
        && d.created_at is timestamp;
    }

    // To ak frè konvèsyon yo (yon dokiman pa pwodwi Finans)
    match /exchange/{id} {
      allow read: if true;
      allow write: if isFullAdmin() && validExchange();
    }

    function validExchange() {
      let d = request.resource.data;
      return exactKeys(['product_name', 'currency', 'rate', 'min', 'max', 'tiers', 'available'])
        && d.product_name is string && d.product_name.size() <= 80
        && d.currency is string && d.currency.size() >= 1 && d.currency.size() <= 10
        && d.rate is number && d.rate > 0 && d.rate <= 1000000
        && d.min is int && d.min >= 1 && d.max is int && d.max >= d.min && d.max <= 1000000
        && d.tiers is list && d.tiers.size() >= 1 && d.tiers.size() <= 30
        && d.available is bool;
    }

    // Ki pwodwi FazerCards ki koresponn ak chak pake (livrezon otomatik). Admin sèlman.
    match /supplierMap/{packageId} {
      allow read: if isAdmin();
      allow delete: if isFullAdmin();
      allow create, update: if isFullAdmin()
        && request.resource.data.keys().hasOnly(['provider', 'category_id', 'category_name', 'offer_id', 'offer_name', 'price_usd', 'field_key', 'auto'])
        && request.resource.data.provider == 'fazercards'
        && request.resource.data.category_id is string && request.resource.data.category_id.size() <= 100
        && request.resource.data.offer_id is string && request.resource.data.offer_id.size() <= 100
        && optString(request.resource.data.get('field_key', null), 60)
        && request.resource.data.auto is bool;
    }

    // settings/catalog: pwodwi sit la ki kache yo.
    // settings/payments: nimewo MonCash/NatCash kliyan yo voye kòb la (pwopriyetè a sèlman).
    // settings/automation: konfimasyon depo otomatik ak SMS (pwopriyetè a sèlman, admin yo li l).
    match /settings/{id} {
      allow read: if id != 'automation' || isAdmin();
      allow write: if (isFullAdmin() && id == 'catalog'
          && request.resource.data.keys().hasOnly(['hidden'])
          && request.resource.data.hidden is list && request.resource.data.hidden.size() <= 300)
        || (isOwner() && id == 'payments'
          && request.resource.data.keys().hasOnly(['moncash', 'natcash'])
          && validPayAccount(request.resource.data.get('moncash', null))
          && validPayAccount(request.resource.data.get('natcash', null)))
        || (isOwner() && id == 'referral'
          && exactKeys(['bonus', 'min_deposit'])
          && request.resource.data.bonus is int && request.resource.data.bonus >= 0 && request.resource.data.bonus <= 5000
          && request.resource.data.min_deposit is int && request.resource.data.min_deposit >= 50 && request.resource.data.min_deposit <= 100000)
        || (isOwner() && id == 'automation'
          && exactKeys(['sms_auto', 'senders', 'max_auto'])
          && request.resource.data.sms_auto is bool
          && request.resource.data.senders is list && request.resource.data.senders.size() <= 10
          && request.resource.data.max_auto is int
          && request.resource.data.max_auto >= 0 && request.resource.data.max_auto <= 100000);
    }

    // SMS NatCash/MonCash sèvè a resevwa nan httpSMS (admin yo sèlman; bot sèvè a se yon admin)
    match /smsPayments/{id} {
      allow read, write: if isFullAdmin();
    }

    // Kòd ki pa bon chak kliyan eseye (sèvè a sèlman), pou pèsonn pa ka devine kòd tranzaksyon
    match /codeChecks/{uid} {
      allow read, write: if isFullAdmin();
    }

    // Paramèt prive sèvè a (ex. alèt Telegram pwopriyetè a): admin yo sèlman
    match /private/{id} {
      allow read, write: if isFullAdmin();
    }

    function validPayAccount(a) {
      return a == null || (a is map && a.keys().hasOnly(['number', 'name'])
        && a.number is string && a.number.matches('^([0-9]{8,15})?$')
        && a.name is string && a.name.size() <= 60);
    }

    // Foto pou pwodwi ki nan sit la deja (pa egzanp STARLINK): admin nan ka chanje l
    match /productImages/{id} {
      allow read: if true;
      allow delete: if isFullAdmin();
      allow create, update: if isFullAdmin() && id.size() <= 60
        && request.resource.data.keys().hasOnly(['image'])
        && request.resource.data.image is string && request.resource.data.image.size() <= 120000
        && request.resource.data.image.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$');
    }

    // ---------- Mesaj pou tout kliyan yo ----------
    match /announcements/{id} {
      allow read: if true;
      allow create: if isFullAdmin()
        && exactKeys(['title', 'body', 'by', 'created_at'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && optString(request.resource.data.body, 1000)
        && request.resource.data.by == me()
        && request.resource.data.created_at == request.time;
      allow delete: if isFullAdmin();
    }

    // ---------- Avi kliyan yo: yon avi pou chak kòmand ki livre ----------
    // Kliyan an ekri l; li parèt sou sit la sèlman lè yon admin apwouve l.
    match /reviews/{orderId} {
      allow read: if resource == null || resource.data.approved == true
        || (signedIn() && (resource.data.user_id == me() || isAdmin()));
      allow create: if signedIn() && validNewReview(orderId);
      allow update: if isFullAdmin() && changedOnly(['approved']) && request.resource.data.approved is bool;
      allow delete: if isFullAdmin();
    }

    function validNewReview(orderId) {
      let d = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return exactKeys(['user_id', 'name', 'product_name', 'rating', 'text', 'approved', 'created_at'])
        && d.user_id == me() && order.user_id == me() && order.status == 'delivered'
        && d.product_name == order.product_name
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.text is string && d.text.size() <= 300
        && d.approved == false && d.created_at == request.time;
    }

    // Kantite kòmand ki livre (paj akèy la): admin yo mete l ajou
    match /stats/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'public'
        && request.resource.data.keys().hasOnly(['delivered'])
        && request.resource.data.delivered is int && request.resource.data.delivered >= 0;
    }

    // ---------- Parennaj: referrals/{uid zanmi an} ----------
    // Zanmi an kreye l touswit apre l fin kreye kont li (lyen ?ref=AWENS-ID). Lè premye depo li a
    // (omwen min_deposit) konfime, yon admin (oswa sèvè a) make l "rewarded" epi bay 2 bonis yo.
    match /referrals/{uid} {
      allow get: if signedIn() && (resource == null || me() == uid || resource.data.referrer_uid == me() || isAdmin());
      allow list: if signedIn() && (resource.data.referrer_uid == me() || isAdmin());
      allow create: if signedIn() && me() == uid && validNewReferral(uid);
      allow update: if isFullAdmin() && changedOnly(['rewarded', 'deposit_id', 'rewarded_at'])
        && resource.data.rewarded == false && request.resource.data.rewarded == true
        && request.resource.data.rewarded_at == request.time
        && referralDepositOk(uid, request.resource.data.deposit_id);
    }

    function validNewReferral(uid) {
      let d = request.resource.data;
      let owner = get(walletCodeDoc(d.referrer_code)).data;
      return exactKeys(['referrer_uid', 'referrer_code', 'rewarded', 'created_at'])
        && d.referrer_uid == owner.uid && d.referrer_uid != uid
        && d.rewarded == false && d.created_at == request.time
        && get(userDoc(uid)).data.created_at > request.time - duration.value(1, 'd');
    }

    function referralDepositOk(uid, depositId) {
      let dep = get(depositDoc(depositId)).data;
      let s = get(/databases/$(database)/documents/settings/referral).data;
      return dep.user_id == uid && dep.status == 'completed' && dep.amount >= s.min_deposit;
    }

    // ---------- Kòd pwomo ----------
    // Admin yo kreye yo. Yon kliyan ka sèlman ajoute 1 sou "uses" lè l sèvi ak kòd la nan yon kòmand.
    match /promos/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isFullAdmin() && validPromo(code) && request.resource.data.uses == 0;
      allow update: if (isFullAdmin() && validPromo(code) && request.resource.data.uses == resource.data.uses)
        || (signedIn() && changedOnly(['uses']) && request.resource.data.uses == resource.data.uses + 1
            && !exists(promoUseDoc(code)) && existsAfter(promoUseDoc(code)));
      allow delete: if isFullAdmin();
    }

    function validPromo(code) {
      let p = request.resource.data;
      return code.matches('^[A-Z0-9]{3,20}$')
        && p.keys().hasOnly(['percent', 'active', 'expires_at', 'max_uses', 'uses', 'created_at'])
        && p.percent is int && p.percent >= 1 && p.percent <= 90
        && p.active is bool
        && (p.expires_at == null || p.expires_at is timestamp)
        && (p.max_uses == null || (p.max_uses is int && p.max_uses >= 1))
        && p.uses is int && p.created_at is timestamp;
    }

    // Yon kliyan sèvi ak yon kòd yon sèl fwa: promoUses/{KÒD}_{uid}
    match /promoUses/{key} {
      allow get: if signedIn() && (resource == null || resource.data.user_id == me() || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && validPromoUse(key);
    }

    function validPromoUse(key) {
      let d = request.resource.data;
      let order = getAfter(/databases/$(database)/documents/orders/$(d.order_id)).data;
      return exactKeys(['user_id', 'order_id', 'created_at'])
        && d.user_id == me() && d.created_at == request.time
        && order.user_id == me() && key == order.promo + '_' + me();
    }

    // ---------- Vizitè yo: yon kontè pa jou (AAAA-MM-JJ, lè Ayiti) ----------
    // Chak vizitè ka sèlman ajoute 1; se admin yo sèlman ki ka li l.
    match /visits/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // ---------- Kòmand yo ----------
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.user_id == me() || isAdmin());
      allow create: if signedIn() && (
        (request.resource.data.get('kind', null) == 'exchange' && validNewExchangeOrder(id))
        || (request.resource.data.get('kind', null) != 'exchange' && request.resource.data.status == 'unpaid' && validNewUnpaidOrder(id))
        || (request.resource.data.get('kind', null) != 'exchange' && request.resource.data.status != 'unpaid' && validNewOrder(id)));
      allow update: if isAdmin() && validOrderUpdate();
    }

    function validNewOrder(id) {
      let d = request.resource.data;
      let pkg = get(packageDoc(d.package_id)).data;
      let before = get(userDoc(me())).data;
      let after = getAfter(userDoc(me())).data;
      let promo = d.get('promo', null);
      return (promo == null
          ? exactKeys(['code', 'user_id', 'package_id', 'product_name', 'package_label', 'price',
                       'player_id', 'status', 'delivery_code', 'admin_note', 'created_at', 'updated_at'])
            && d.price == pkg.price
          : exactKeys(['code', 'user_id', 'package_id', 'product_name', 'package_label', 'price',
                       'player_id', 'status', 'delivery_code', 'admin_note', 'created_at', 'updated_at', 'promo', 'list_price'])
            && validOrderPromo(d, pkg))
        && d.user_id == me()
        && pkg.available == true
        && d.product_name == pkg.product_name && d.package_label == pkg.label
        && d.status == 'pending' && d.delivery_code == null && d.admin_note == null
        && (d.player_id == null || (d.player_id is string && d.player_id.matches('^[0-9]{6,15}$')))
        && (pkg.needs_id != true || d.player_id != null)
        && d.code is string && d.code.matches('^AS-[A-HJ-NP-Z2-9]{6}$')
        && d.created_at == request.time && d.updated_at == request.time
        && after.balance == before.balance - d.price
        && after.total_spent == before.total_spent + d.price
        && after.last_op == {'kind': 'order', 'id': id};
    }

    // Yon kòmand ak kòd pwomo: pri a = pri pake a mwens pousantaj la (arondi anba), kòd la aktif,
    // pa ekspire, pa depase kantite fwa li ka sèvi, e kliyan an poko janm sèvi ak li
    function validOrderPromo(d, pkg) {
      let path = /databases/$(database)/documents/promos/$(d.promo);
      let p = get(path).data;
      return d.promo is string && d.list_price == pkg.price
        && p.active == true
        && (p.expires_at == null || p.expires_at > request.time)
        && (p.max_uses == null || p.uses < p.max_uses)
        && getAfter(path).data.uses == p.uses + 1
        && !exists(promoUseDoc(d.promo)) && existsAfter(promoUseDoc(d.promo))
        && d.price == pkg.price - math.floor(pkg.price * p.percent / 100.0);
    }

    function promoUseDoc(code) {
      return /databases/$(database)/documents/promoUses/$(code + '_' + me());
    }

    // Kliyan an peye dirèkteman ak MonCash/NatCash: kòmand lan tann admin nan konfime peman an.
    // Solde a pa chanje; nimewo tranzaksyon an ka sèvi yon sèl fwa (depositRefs).
    function validNewUnpaidOrder(id) {
      let d = request.resource.data;
      let pkg = get(packageDoc(d.package_id)).data;
      let ref = depositRefDoc(d.payment.method + '_' + d.payment.reference);
      return exactKeys(['code', 'user_id', 'package_id', 'product_name', 'package_label', 'price',
                        'player_id', 'status', 'delivery_code', 'admin_note', 'created_at', 'updated_at', 'payment'])
        && d.user_id == me()
        && pkg.available == true
        && d.price == pkg.price && d.product_name == pkg.product_name && d.package_label == pkg.label
        && d.status == 'unpaid' && d.delivery_code == null && d.admin_note == null
        && (d.player_id == null || (d.player_id is string && d.player_id.matches('^[0-9]{6,15}$')))
        && (pkg.needs_id != true || d.player_id != null)
        && d.code is string && d.code.matches('^AS-[A-HJ-NP-Z2-9]{6}$')
        && d.created_at == request.time && d.updated_at == request.time
        && validPayment(d.payment)
        && refUnused(d.payment.reference)
        && getAfter(ref).data.order_id == id;
    }

    function validPayment(p) {
      return p is map && p.keys().hasOnly(['method', 'reference', 'sender_phone']) && p.keys().hasAll(['method', 'reference'])
        && p.method in ['moncash', 'natcash']
        && p.reference is string && p.reference.matches('^[A-Z0-9]{4,40}$')
        && optString(p.get('sender_phone', null), 20);
    }

    // Konvèsyon (Meru, PayPal…): pri a = (montan + frè palye a) × to a, arondi anlè.
    // Menm kalkil ak exchange.js. `tier` se palye kliyan an chwazi: nou verifye se bon an.
    function validNewExchangeOrder(id) {
      let d = request.resource.data;
      let ex = get(exchangeDoc(d.package_id)).data;
      let t = ex.tiers;
      let i = d.tier;
      let before = get(userDoc(me())).data;
      let after = getAfter(userDoc(me())).data;
      return exactKeys(['code', 'user_id', 'package_id', 'product_name', 'package_label', 'price',
                        'player_id', 'status', 'delivery_code', 'admin_note', 'created_at', 'updated_at',
                        'kind', 'amount', 'fee', 'tier', 'rate', 'currency', 'recipient'])
        && d.user_id == me()
        && ex.available == true
        && d.amount is int && d.amount >= ex.min && d.amount <= ex.max
        && i is int && i >= 0 && i < t.size()
        && (d.amount <= t[i].max || i == t.size() - 1)
        && (i == 0 || d.amount > t[i - 1].max)
        && d.fee == t[i].fee
        && d.rate == ex.rate && d.currency == ex.currency && d.product_name == ex.product_name
        && d.price is int && d.price == math.ceil((d.amount + d.fee) * ex.rate)
        && d.package_label == string(d.amount) + ' ' + ex.currency
        && d.player_id == null
        && validRecipient(d.recipient)
        && d.status == 'pending' && d.delivery_code == null && d.admin_note == null
        && d.code is string && d.code.matches('^AS-[A-HJ-NP-Z2-9]{6}$')
        && d.created_at == request.time && d.updated_at == request.time
        && after.balance == before.balance - d.price
        && after.total_spent == before.total_spent + d.price
        && after.last_op == {'kind': 'order', 'id': id};
    }

    function validRecipient(r) {
      return r is map && r.keys().hasOnly(['account', 'name']) && r.keys().hasAll(['account', 'name'])
        && r.account is string && r.account.size() >= 3 && r.account.size() <= 120
        && r.name is string && r.name.size() >= 2 && r.name.size() <= 80;
    }

    function validOrderUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let u = userDoc(before.user_id);
      return changedOnly(['status', 'delivery_code', 'admin_note', 'updated_at', 'supplier'])
        && before.status != 'refused'
        && after.status in ['pending', 'processing', 'delivered', 'refused']
        && after.updated_at == request.time
        && optString(after.delivery_code, 200)
        && optString(after.admin_note, 300)
        && (!('supplier' in after) || validSupplier(after.supplier))
        && (before.status == 'unpaid'
          // Peman dirèk: refize = pa gen ranbousman (kliyan an pa t peye ak solde l);
          // konfime = pri a ajoute nan total kliyan an (paidOk)
          ? (after.status == 'refused'
              ? getAfter(u).data.balance == get(u).data.balance
              : isFullAdmin() && getAfter(u).data.total_spent == get(u).data.total_spent + before.price)
          : (after.status != 'refused' || getAfter(u).data.balance == get(u).data.balance + before.price));
    }

    // Livrezon otomatik (FazerCards): estati kòmand lan kote founisè a
    function validSupplier(s) {
      return s is map && s.keys().hasOnly(['provider', 'order_id', 'status', 'error', 'offer_name', 'at'])
        && s.provider == 'fazercards'
        && optString(s.get('order_id', null), 60)
        && s.status is string && s.status.size() <= 20
        && optString(s.get('error', null), 300)
        && optString(s.get('offer_name', null), 120);
    }

    // ---------- Depo yo ----------
    match /deposits/{id} {
      allow read: if signedIn() && (resource.data.user_id == me() || isAdmin());
      allow create: if signedIn() && validNewDeposit(id);
      allow update: if isFullAdmin() && validDepositReview();
    }

    function validNewDeposit(id) {
      let d = request.resource.data;
      let key = d.method + '_' + d.reference;
      let ref = depositRefDoc(key);
      return exactKeys(['user_id', 'amount', 'method', 'reference', 'sender_phone', 'status',
                        'admin_note', 'created_at', 'updated_at'])
        && d.user_id == me() && d.status == 'pending' && d.admin_note == null
        && d.amount is int && d.amount >= 50 && d.amount <= 100000
        && d.method in ['moncash', 'natcash']
        && d.reference is string && d.reference.matches('^[A-Z0-9]{4,40}$')
        && optString(d.sender_phone, 20)
        && d.created_at == request.time && d.updated_at == request.time
        && refUnused(d.reference)
        && getAfter(ref).data.deposit_id == id;
    }

    // Yon kòd tranzaksyon sèvi yon sèl fwa, kèlkeswa mòd peman an (NatCash oswa MonCash)
    function refUnused(reference) {
      return !exists(depositRefDoc('natcash_' + reference)) && !exists(depositRefDoc('moncash_' + reference));
    }

    function validDepositReview() {
      let before = resource.data;
      let after = request.resource.data;
      let u = userDoc(before.user_id);
      return changedOnly(['status', 'admin_note', 'updated_at'])
        && before.status == 'pending'
        && after.status in ['completed', 'refused']
        && after.updated_at == request.time
        && optString(after.admin_note, 300)
        && (after.status != 'completed' || getAfter(u).data.balance == get(u).data.balance + before.amount);
    }

    // Yon nimewo tranzaksyon MonCash/NatCash ka sèvi yon sèl fwa
    match /depositRefs/{key} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == me() && (
        (request.resource.data.keys().hasOnly(['deposit_id', 'user_id'])
          && depositRefOk(key, getAfter(depositDoc(request.resource.data.deposit_id)).data))
        || (request.resource.data.keys().hasOnly(['order_id', 'user_id'])
          && orderRefOk(key, request.resource.data.order_id)));
    }

    function depositRefOk(key, d) {
      return d.user_id == me() && key == d.method + '_' + d.reference;
    }

    // Kòmand peye dirèkteman: nimewo tranzaksyon an se pou nouvo kòmand sa a
    function orderRefOk(key, id) {
      let o = getAfter(orderDoc(id)).data;
      return !exists(orderDoc(id)) && o.user_id == me() && o.status == 'unpaid'
        && key == o.payment.method + '_' + o.payment.reference;
    }

    // ---------- Transfè yo ----------
    match /transfers/{id} {
      allow read: if signedIn() && (resource.data.from_user == me() || resource.data.to_user == me() || isAdmin());
      allow create: if signedIn() && validNewTransfer();
    }

    function validNewTransfer() {
      let d = request.resource.data;
      let from = userDoc(me());
      let to = userDoc(d.to_user);
      return exactKeys(['from_user', 'to_user', 'from_code', 'to_code', 'amount', 'created_at'])
        && d.from_user == me()
        && d.to_user is string && d.to_user != me()
        && d.amount is int && d.amount >= 10
        && d.created_at == request.time
        && d.from_code == get(from).data.wallet_code
        && d.to_code == get(to).data.wallet_code
        && getAfter(from).data.balance == get(from).data.balance - d.amount
        && getAfter(to).data.balance == get(to).data.balance + d.amount;
    }

    // ---------- Notifikasyon ----------
    function validNotification() {
      let d = request.resource.data;
      return exactKeys(['kind', 'title', 'body', 'ref', 'read_at', 'created_at'])
        && d.kind in ['order', 'deposit', 'transfer', 'info', 'message']
        && d.title is string && d.title.size() <= 120
        && optString(d.body, 1000)
        && optString(d.ref, 100)
        && d.read_at == null
        && d.created_at == request.time;
    }

    // Moun k ap voye kòb la ka avèti moun k ap resevwa a, nan menm operasyon an
    function transferNotificationOk(uid) {
      let path = transferDoc(request.resource.data.ref);
      return request.resource.data.kind == 'transfer'
        && !exists(path)
        && getAfter(path).data.to_user == uid
        && getAfter(path).data.from_user == me();
    }
  }
}
